COMPOSE_PROFILES=db

GOPOLI_BIND_ADDRESS=127.0.0.1
GOPOLI_API_PORT=8080
GOPOLI_WEB_PORT=3000

GOPOLI_DB_TAG=latest
GOPOLI_API_TAG=latest
GOPOLI_WEB_TAG=latest

POSTGRES_DB=gopoli
POSTGRES_USER=gopoli
POSTGRES_PASSWORD=<DB_PASSWORD>
GOPOLI_SEED_DEMO=false

APP_TIMEZONE=America/Bogota
LOG_LEVEL=INFO
SPRING_DATASOURCE_URL=jdbc:postgresql://db-gopoli:5432/gopoli
SPRING_DATASOURCE_USERNAME=gopoli
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>
DB_POOL_SIZE=10

GOPOLI_JWT_SECRET=<JWT_SECRET_MIN_32_CHARS>
GOPOLI_JWT_EXPIRATION_HOURS=168

CORS_ALLOWED_ORIGINS=https://<WEB_PUBLIC_DOMAIN>
NEXT_PUBLIC_API_URL=https://<API_PUBLIC_DOMAIN>
